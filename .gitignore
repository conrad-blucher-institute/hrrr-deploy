# Environment files with sensitive information
.env

# Data directories - exclude large data files from version control
data/download/
data/output/
data/archive/
data/logs/
data/analysis/

# Keep directory structure but ignore contents
!data/
!data/.gitkeep
!data/download/.gitkeep
!data/output/.gitkeep
!data/archive/.gitkeep
!data/logs/.gitkeep
!data/analysis/.gitkeep

# Python cache
__pycache__/
*.pyc
*.pyo

# Temporary files
*.tmp
*.temp
/tmp/

# Log files
*.log

# Compressed files
*.zip
*.gz
*.tar

# GRIB files
*.grib2

# Keep scripts directory
!scripts/

# HPC logs
logs/